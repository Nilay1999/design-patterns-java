      "locked": false
    },
    {
      "id": "el1122",
      "type": "text",
      "x": 2067.6,
      "y": 1509.25,
      "width": 405.90000000000003,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
