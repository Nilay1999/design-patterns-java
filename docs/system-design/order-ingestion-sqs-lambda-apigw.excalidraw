      "link": null,
      "locked": false,
      "fontSize": 13,
      "fontFamily": 3,
      "text": "PARKING LOT -- NO AUTOMATIC REDRIVE.\nEvery message here is a LOST ORDER: page on depth > 0.\nRedrive into a FIFO queue re-inserts an old message\nBEHIND newer ones for the same customer -> silent\nordering violation. Replay via reconciliation only.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "PARKING LOT -- NO AUTOMATIC REDRIVE.\nEvery message here is a LOST ORDER: page on depth > 0.\nRedrive into a FIFO queue re-inserts an old message\nBEHIND newer ones for the same customer -> silent\nordering violation. Replay via reconciliation only.",
      "lineHeight": 1.25,
      "autoResize": true
    },
